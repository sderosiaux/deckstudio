{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "resolveJsonModule": true, "types": ["node"], "noEmit": true
  },
  "include": ["src", "web/src", "tests", "e2e", "scripts"]
}
